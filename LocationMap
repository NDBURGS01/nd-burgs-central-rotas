<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#09090d">
<title>ND BURGS | Acompanhe sua entrega</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
*{box-sizing:border-box}
body{margin:0;background:#09090d;color:#f7f7f8;font:15px system-ui,Arial,sans-serif}
.top{padding:19px 16px;background:linear-gradient(120deg,#050507,#211020,#09090d);border-bottom:2px solid #ffc928;text-align:center}
.brand{font-size:24px;font-weight:1000;letter-spacing:1px;color:#ffc928}
.top h1{margin:8px 0 5px;font-size:19px}.top p{margin:0;color:#c4c5ca;font-size:13px}
.wrap{width:100%;max-width:1000px;margin:auto;padding:14px}
.status{padding:15px;border:1px solid #393541;background:linear-gradient(120deg,#1b1920,#111016);border-radius:13px;margin-bottom:12px;line-height:1.5}
.status b{color:#ffc928}.live{color:#35e58d;font-size:12px;font-weight:900;margin-top:7px}
#map{width:100%;height:70vh;min-height:420px;max-height:760px;border:2px solid #9d7b22;border-radius:16px;overflow:hidden;background:#15131b}
.leaflet-container{font-family:system-ui,Arial,sans-serif;background:#15131b}
.leaflet-tile-pane{filter:invert(100%) hue-rotate(180deg) brightness(88%) contrast(90%)}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#19171f;color:white;border:1px solid #6f5720}
.pin{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#ffc928;color:#111;border:3px solid #fff;box-shadow:0 0 18px #ffc92899;font-size:22px}
.none{padding:22px;text-align:center;color:#c3c5cb;border:1px dashed #555;border-radius:12px;background:#19171f;line-height:1.6;margin-top:12px}
.foot{text-align:center;color:#8e929b;font-size:11px;padding:22px 10px;line-height:1.6}
@media(max-width:600px){.top{padding:17px 12px}.brand{font-size:22px}.top h1{font-size:17px}.wrap{padding:10px}#map{height:66vh;min-height:400px;border-radius:12px}}
</style>
</head>
<body>
<header class="top"><div class="brand">ND BURGS</div><h1>📍 Acompanhe sua entrega</h1><p>Este mapa mostra somente o motoboy atribuído ao seu pedido.</p></header>
<main class="wrap">
 <div class="status"><div id="status"><b>Conectando ao acompanhamento...</b></div><div class="live">● ATUALIZAÇÃO AUTOMÁTICA</div></div>
 <div id="map"></div>
 <div id="empty" class="none" style="display:none"></div>
 <div class="foot"><strong>ND BURGS</strong><br>Por segurança, este link exibe somente a localização do motoboy responsável por esta entrega. Ele não mostra outros motoboys nem outros pedidos.</div>
</main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const TRACKING_TOKEN = '<?= trackingToken ?>';
const map = L.map('map',{zoomControl:true,scrollWheelZoom:true}).setView([-23.602,-46.919],12);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);
const driverIcon=L.divIcon({className:'',html:'<div class="pin">🛵</div>',iconSize:[44,44],iconAnchor:[22,22]});
let marker=null, firstFix=true, lastStatus='';
function showEmpty(message){const el=document.getElementById('empty');el.style.display='block';el.textContent=message;}
function refresh(){
 if(!TRACKING_TOKEN){document.getElementById('status').textContent='Link individual inválido.';showEmpty('Solicite à ND BURGS um novo link de acompanhamento.');return;}
 google.script.run.withSuccessHandler(r=>{
   if(!r||!r.ok){document.getElementById('status').textContent=(r&&r.message)||'Não foi possível localizar este pedido.';showEmpty('Confira se o link está correto.');return;}
   const status=document.getElementById('status');
   const empty=document.getElementById('empty');
   if(r.status==='entregue'){
     status.innerHTML='<b>Entrega concluída.</b> Obrigado por pedir na ND BURGS!';
     if(marker){map.removeLayer(marker);marker=null;}
     showEmpty('Este acompanhamento foi encerrado porque o pedido já foi entregue.');
     return;
   }
   if(r.status==='aguardando'){
     status.innerHTML='<b>Seu pedido ainda não saiu para entrega.</b> Assim que o motoboy iniciar a rota, a localização aparecerá aqui.';
     if(marker){map.removeLayer(marker);marker=null;}
     showEmpty('Aguardando o início da entrega.');
     return;
   }
   if(!r.location){
     status.innerHTML='<b>Seu pedido está em entrega.</b> O GPS do motoboy ainda não enviou uma posição recente.';
     if(marker){map.removeLayer(marker);marker=null;}
     showEmpty('Aguardando uma atualização de localização do motoboy responsável.');
     return;
   }
   empty.style.display='none';
   const lat=Number(r.location.lat),lng=Number(r.location.lng);
   if(!Number.isFinite(lat)||!Number.isFinite(lng))return;
   status.innerHTML='<b>Seu pedido está em entrega.</b> A posição do motoboy responsável está sendo atualizada.';
   if(marker){marker.setLatLng([lat,lng]);}
   else{marker=L.marker([lat,lng],{icon:driverIcon}).addTo(map).bindPopup('<b>Motoboy da sua entrega</b>');}
   if(firstFix){map.setView([lat,lng],16);marker.openPopup();firstFix=false;}
 }).withFailureHandler(()=>{
   document.getElementById('status').textContent='Falha temporária ao atualizar. Tentando novamente...';
 }).apiPublicOrderLocation(TRACKING_TOKEN);
}
refresh();
setInterval(refresh,5000);
window.addEventListener('load',()=>setTimeout(()=>map.invalidateSize(),350));
window.addEventListener('resize',()=>map.invalidateSize());
</script>
</body>
</html>
